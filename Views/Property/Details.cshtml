@model Bhoomilink.Models.Property

@{
    ViewData["Title"] = "Property Details";
}

<div class="container py-5">

    <a asp-action="BuyProperties"
       class="btn btn-outline-secondary mb-4">
        ← Back to Properties
    </a>

    <div class="row">

        <!-- LEFT SIDE -->
        <div class="col-lg-7">

            <!-- Image Carousel -->
            <div id="propertyCarousel"
                 class="carousel slide shadow rounded overflow-hidden"
                 data-bs-ride="carousel">

                <div class="carousel-inner">

                    <div class="carousel-item active">
                        <img src="@Model.ImageUrl"
                             class="d-block w-100 property-main-image"
                             alt="Property Image">
                    </div>

                    <div class="carousel-item">
                        <img src="~/images/properties/images2.jpeg"
                             class="d-block w-100 property-main-image"
                             alt="">
                    </div>

                    <div class="carousel-item">
                        <img src="~/images/properties/image3.jpeg"
                             class="d-block w-100 property-main-image"
                             alt="">
                    </div>

                    <div class="carousel-item">
                        <img src="~/images/properties/images4.jpeg"
                             class="d-block w-100 property-main-image"
                             alt="">
                    </div>

                </div>

                <button class="carousel-control-prev"
                        type="button"
                        data-bs-target="#propertyCarousel"
                        data-bs-slide="prev">

                    <span class="carousel-control-prev-icon"></span>

                </button>

                <button class="carousel-control-next"
                        type="button"
                        data-bs-target="#propertyCarousel"
                        data-bs-slide="next">

                    <span class="carousel-control-next-icon"></span>

                </button>

            </div>

            <!-- Thumbnail Images -->
            <div class="row g-2 mt-2">

                <div class="col-3">
                    <img src="@Model.ImageUrl"
                         class="img-thumbnail thumb-img"
                         data-bs-target="#propertyCarousel"
                         data-bs-slide-to="0">
                </div>

                <div class="col-3">
                    <img src="~/images/properties/images2.jpeg"
                         class="img-thumbnail thumb-img"
                         data-bs-target="#propertyCarousel"
                         data-bs-slide-to="1">
                </div>

                <div class="col-3">
                    <img src="~/images/properties/image3.jpeg"
                         class="img-thumbnail thumb-img"
                         data-bs-target="#propertyCarousel"
                         data-bs-slide-to="2">
                </div>

                <div class="col-3">
                    <img src="~/images/properties/images4.jpeg"
                         class="img-thumbnail thumb-img"
                         data-bs-target="#propertyCarousel"
                         data-bs-slide-to="3">
                </div>

            </div>

        </div>

        <!-- RIGHT SIDE -->
        <!-- RIGHT SIDE -->
        <div class="col-lg-5">

            <div class="card border-0 shadow-lg rounded-4">

                <div class="card-body p-4">

                    <div class="d-flex justify-content-between align-items-start">

                        <div>

                            <span class="badge bg-success px-3 py-2 rounded-pill">
                                ✓ Phone Verified
                            </span>

                        </div>

                        <div>

                            <button class="btn btn-light rounded-circle border me-2">
                                ❤
                            </button>

                            <button class="btn btn-light rounded-circle border">
                                🔗
                            </button>

                        </div>

                    </div>

                    <h2 class="fw-bold mt-4 mb-2">
                        @Model.Title
                    </h2>

                    <h2 class="text-success fw-bold mb-3">

                        ₹ @String.Format("{0:N0}", Model.Price)

                    </h2>

                    <p class="text-muted fs-5">

                        📍 @Model.Location

                    </p>

                    <hr />

                    <div class="row text-center g-3">

                        <div class="col-4">
                            <div class="feature-circle">🛏</div>
                            <h5 class="mt-2">@Model.Bedrooms</h5>
                            <small>Bedrooms</small>
                        </div>

                        <div class="col-4">
                            <div class="feature-circle">🚿</div>
                            <h5 class="mt-2">@Model.Bathrooms</h5>
                            <small>Bathrooms</small>
                        </div>

                        <div class="col-4">
                            <div class="feature-circle">📐</div>
                            <h5 class="mt-2">@Model.Area</h5>
                            <small>Area</small>
                        </div>

                        <div class="col-4">
                            <div class="feature-circle">🧭</div>
                            <h5 class="mt-2">@Model.Facing</h5>
                            <small>Facing</small>
                        </div>

                        <div class="col-4">
                            <div class="feature-circle">🏢</div>
                            <h5 class="mt-2">@Model.Type</h5>
                            <small>Type</small>
                        </div>

                        <div class="col-4">
                            <div class="feature-circle">🚗</div>
                            <h5 class="mt-2">Yes</h5>
                            <small>Parking</small>
                        </div>

                    </div>

                    <hr />

                </div>

            </div>

        </div>

    </div>

    <!-- Description & Property Information -->
    <div class="row mt-5">

        <!-- LEFT -->
        <div class="col-lg-8">

            <!-- Property Description -->
            <div class="card shadow-sm border-0 rounded-4 mb-4">

                <div class="card-body p-4">

                    <h4 class="fw-bold mb-3">
                        📝 Property Description
                    </h4>

                    <p class="text-muted mb-0">
                        @Model.Description
                    </p>

                </div>

            </div>

            <!-- Amenities -->
            <div class="card shadow-sm border-0 rounded-4 mb-4">

                <div class="card-body p-4">

                    <h4 class="fw-bold mb-4">
                        🏡 Amenities
                    </h4>

                    <div class="row">

                        <div class="col-md-4 col-6 mb-3">
                            <span class="amenity-badge">✔ Lift</span>
                        </div>

                        <div class="col-md-4 col-6 mb-3">
                            <span class="amenity-badge">✔ CCTV</span>
                        </div>

                        <div class="col-md-4 col-6 mb-3">
                            <span class="amenity-badge">✔ Security</span>
                        </div>

                        <div class="col-md-4 col-6 mb-3">
                            <span class="amenity-badge">✔ Gym</span>
                        </div>

                        <div class="col-md-4 col-6 mb-3">
                            <span class="amenity-badge">✔ Power Backup</span>
                        </div>

                        <div class="col-md-4 col-6 mb-3">
                            <span class="amenity-badge">✔ Children's Park</span>
                        </div>

                    </div>

                </div>

            </div>

            <!-- Nearby Places -->
            <div class="card shadow-sm border-0 rounded-4">

                <div class="card-body p-4">

                    <h4 class="fw-bold mb-4">
                        📍 Nearby Places
                    </h4>

                    <div class="row text-center">

                        <div class="col-4">

                            <div class="nearby-icon">🏫</div>

                            <h6 class="mt-3">School</h6>

                            <small class="text-muted">500 m</small>

                        </div>

                        <div class="col-4">

                            <div class="nearby-icon">🏥</div>

                            <h6 class="mt-3">Hospital</h6>

                            <small class="text-muted">1 km</small>

                        </div>

                        <div class="col-4">

                            <div class="nearby-icon">🏖</div>

                            <h6 class="mt-3">Beach</h6>

                            <small class="text-muted">3 km</small>

                        </div>

                    </div>

                </div>

            </div>

        </div>

        <!-- RIGHT -->
        <div class="col-lg-4">

            <div class="card shadow-lg border-0 rounded-4 sticky-top"
                 style="top:90px;">

                <div class="card-body p-4">

                    <!-- Contact Seller Header -->
                    <div class="text-center mb-4">

                        <div class="seller-icon mb-3">

                            <i class="bi bi-person-lines-fill"></i>

                        </div>

                        <h4 class="fw-bold mb-2">
                            Contact Seller
                        </h4>

                        <span class="badge bg-success px-3 py-2 rounded-pill">
                            ✓ Phone Verified
                        </span>

                        <p class="text-muted small mt-3 mb-0">
                            Contact the seller directly for property details,
                            site visit and price negotiation.
                        </p>

                    </div>

                    <hr />

                    <!-- Contact Buttons -->
                    <div class="d-grid gap-3">

                        <!-- Show Phone Number -->
                        <button class="btn btn-success btn-lg rounded-3"
                                type="button"
                                data-bs-toggle="collapse"
                                data-bs-target="#showPhone">

                            <i class="bi bi-telephone-fill me-2"></i>

                            Show Phone Number

                        </button>

                        <div class="collapse" id="showPhone">

                            <div class="card border-success shadow-sm">

                                <div class="card-body text-center">

                                    <small class="text-muted">
                                        Seller Contact Number
                                    </small>

                                    <h4 class="text-success fw-bold my-3">

                                        +91 95817 51622

                                    </h4>

                                    <a href="tel:+919581751622"
                                       class="btn btn-success rounded-pill px-4">

                                        <i class="bi bi-telephone-fill me-2"></i>

                                        Call Now

                                    </a>

                                </div>

                            </div>

                        </div>

                        <!-- WhatsApp -->
                        <a href="https://wa.me/919581751622"
                           target="_blank"
                           class="btn btn-outline-success btn-lg rounded-3">

                            <i class="bi bi-whatsapp me-2"></i>

                            Chat on WhatsApp

                        </a>

                    </div>

                    <hr />

                    <!-- Buyer Safety Notice -->
                    <div class="buyer-safety">

                        <div class="d-flex">

                            <div class="buyer-safety-icon">
                                <i class="bi bi-shield-check"></i>
                            </div>

                            <div>

                                <h6>Buy Safely</h6>

                                <p>
                                    BhoomiLink manually reviews property submissions before publishing.
                                    Before making any payment or signing an agreement, please verify:
                                </p>

                                <ul>

                                    <li>Ownership & Identity</li>

                                    <li>Government Approvals (VMRDA / DTCP / APCRDA, if applicable)</li>

                                    <li>Legal Documents</li>

                                    <li>Property Measurements & Boundaries</li>

                                    <li>Price & Payment Terms</li>

                                </ul>

                                <small class="text-muted">
                                    BhoomiLink is a property listing platform and is not a party to property transactions.
                                </small>

                            </div>

                        </div>

                    </div>

                    <hr />

                    <!-- Property Info -->
                    <table class="table table-borderless mb-0">

                        <tr>

                            <td class="text-muted">Property ID</td>

                            <td class="text-end fw-bold">
                                BL000123
                            </td>

                        </tr>

                        <tr>

                            <td class="text-muted">Posted</td>

                            <td class="text-end">
                                Today
                            </td>

                        </tr>

                        <tr>

                            <td class="text-muted">Views</td>

                            <td class="text-end">
                                125
                            </td>

                        </tr>

                        <tr>

                            <td class="text-muted">Listed By</td>

                            <td class="text-end">
                                Owner
                            </td>

                        </tr>

                    </table>

                </div>

            </div>

        </div>

    </div>

</div>