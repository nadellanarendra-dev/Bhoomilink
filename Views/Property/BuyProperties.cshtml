@model List<Bhoomilink.Models.Property>

@{
    ViewData["Title"] = "Buy Properties";
}

<div class="container py-5">

    <div class="text-center mb-5">

        <h1 class="fw-bold">

            Buy Properties

        </h1>

        <p class="text-muted">

            Explore our demo property listings across Andhra Pradesh.

        </p>

    </div>

    <div class="row">

        @foreach (var item in Model)
        {

            <div class="col-lg-4 col-md-6 mb-4">

                <div class="card property-card h-100 shadow">

                    <img src="@item.ImageUrl"
                         class="card-img-top">

                    <div class="card-body">

                        <span class="badge bg-success">

                            Demo Listing

                        </span>

                        <span class="badge bg-primary ms-2">

                            @item.Type

                        </span>

                        <h5 class="mt-3 fw-bold">

                            @item.Title

                        </h5>

                        <p>

                            📍 @item.Location

                        </p>

                        <h4 class="text-success">

                            ₹@String.Format("{0:N0}", item.Price)

                        </h4>

                        <hr />

                        <div class="row text-center">

                            <div class="col">

                                🛏

                                <br />

                                @item.Bedrooms

                            </div>

                            <div class="col">

                                🚿

                                <br />

                                @item.Bathrooms

                            </div>

                            <div class="col">

                                📐

                                <br />

                                @item.Area

                            </div>

                        </div>

                    </div>

                    <div class="card-footer bg-white border-0">

                        <a asp-controller="Property"
                           asp-action="Details"
                           asp-route-id="@item.Id"
                           class="btn btn-success w-100">

                            View Details

                        </a>

                    </div>

                </div>

            </div>

        }

    </div>

</div>