@{
    ViewData["Title"] = "Disclaimer";
}

<link href="~/css/privacy-policy.css" rel="stylesheet" />

<!-- Hero -->

<section class="privacy-hero">

    <div class="container text-center">

        <span class="hero-badge">

            <i class="bi bi-exclamation-triangle-fill"></i>

            Disclaimer

        </span>

        <h1>
            Website Disclaimer
        </h1>

        <p>
            Please read this disclaimer carefully before using BhoomiLink.
            By accessing this website, you acknowledge and agree to the terms
            outlined below.
        </p>

        <small class="text-muted">

            Last Updated: August 2026

        </small>

    </div>

</section>

<!-- Content -->

<section class="privacy-content">

    <div class="container">

        <!-- General -->

        <div class="policy-card">

            <h3>

                <i class="bi bi-info-circle-fill"></i>

                General Information

            </h3>

            <p>

                BhoomiLink is an online property listing platform that connects
                property buyers, sellers, owners, agents, and developers.
                The information available on this website is provided for
                general informational purposes only.

            </p>

        </div>

        <!-- Listing Accuracy -->

        <div class="policy-card">

            <h3>

                <i class="bi bi-house-check-fill"></i>

                Property Listings

            </h3>

            <p>

                Property details, descriptions, prices, photographs, approvals,
                dimensions, and availability are provided by property owners,
                agents, or developers.

                Although BhoomiLink manually reviews listings before publishing,
                we do not guarantee that every listing is accurate, complete,
                or up to date.

            </p>

        </div>

        <!-- Verification -->

        <div class="policy-card">

            <h3>

                <i class="bi bi-patch-check-fill"></i>

                Independent Verification

            </h3>

            <p>

                Buyers, tenants, and investors should independently verify
                ownership, legal documents, government approvals, measurements,
                pricing, and all other property details before making any
                payment, booking, or transaction.

            </p>

        </div>

        <!-- Liability -->

        <div class="policy-card">

            <h3>

                <i class="bi bi-shield-exclamation"></i>

                Limitation of Liability

            </h3>

            <p>

                BhoomiLink shall not be held responsible for any loss,
                damage, dispute, fraud, or legal issue arising from
                property transactions, negotiations, agreements, or
                communications between buyers and sellers.

            </p>

        </div>

        <!-- External Links -->

        <div class="policy-card">

            <h3>

                <i class="bi bi-box-arrow-up-right"></i>

                Third-Party Services

            </h3>

            <p>

                BhoomiLink may provide links to third-party websites or
                services such as Google Maps, WhatsApp, or Google Forms.
                We are not responsible for the content, policies, or
                availability of those external services.

            </p>

        </div>

        <!-- Updates -->

        <div class="policy-card">

            <h3>

                <i class="bi bi-arrow-repeat"></i>

                Updates to this Disclaimer

            </h3>

            <p>

                BhoomiLink reserves the right to modify or update this
                Disclaimer at any time without prior notice.
                Continued use of the website indicates acceptance of
                any updated version.

            </p>

        </div>

        <!-- Contact -->

        <div class="policy-card">

            <h3>

                <i class="bi bi-envelope-fill"></i>

                Contact Us

            </h3>

            <p>

                If you have any questions regarding this Disclaimer,
                please contact us.

            </p>

            <p>

                <strong>Email:</strong> bhoomilinks@gmail.com<br />

                <strong>Phone:</strong> +91 95817 51622

            </p>

        </div>

    </div>

</section>