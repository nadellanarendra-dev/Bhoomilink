@{
    ViewData["Title"] = "Home";
}

<!-- ================= HERO ================= -->

<section class="hero">

    <div class="container">

        <div class="row align-items-center">

            <!-- LEFT SIDE -->

            <div class="col-lg-6">

                <h1 class="display-3 fw-bold mb-3 hero-title">

                    Find Your Dream

                    <br />

                    Property

                </h1>

                <h2 class="text-success fw-bold mb-4">

                    Across Andhra Pradesh

                </h2>

                <p class="lead text-muted mb-4">

                    Discover verified properties across Andhra Pradesh with direct owner contact.

                </p>

                <div class="d-flex flex-wrap gap-3">

                    <a asp-controller="Property"
                       asp-action="BuyProperties"
                       class="btn btn-success btn-lg rounded-pill px-4">

                        <i class="bi bi-house-fill me-2"></i>

                        Buy Property

                    </a>

                    <a asp-controller="SellProperty"
                       asp-action="Index"
                       class="btn btn-success btn-lg rounded-pill px-4">

                        <i class="bi bi-house-fill me-2"></i>

                        Sell Property

                    </a>

                </div>

            </div>

            <!-- RIGHT SIDE -->

            <div class="col-lg-6 text-center">

                <img src="~/images/Homebanner.png"
                     class="img-fluid hero-image"
                     alt="BhoomiLink Andhra Pradesh">

            </div>

        </div>

    </div>

</section>

