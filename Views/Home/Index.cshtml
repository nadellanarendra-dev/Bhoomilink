            </h2>

        </div>

        <div class="row g-4">

            <div class="col-lg-3">

                <div class="card border-0 shadow-sm text-center p-4 h-100">

                    <div class="display-5">✅</div>

                    <h5 class="mt-3">Verified Listings</h5>

                    <p class="text-muted">

                        Every property is reviewed before publishing.

                    </p>

                </div>

            </div>

            <div class="col-lg-3">

                <div class="card border-0 shadow-sm text-center p-4 h-100">

                    <div class="display-5">📞</div>

                    <h5 class="mt-3">Direct Contact</h5>

                    <p class="text-muted">

                        Connect directly with property sellers.

                    </p>

                </div>

            </div>

            <div class="col-lg-3">

                <div class="card border-0 shadow-sm text-center p-4 h-100">

                    <div class="display-5">🏡</div>

                    <h5 class="mt-3">Wide Choice</h5>

                    <p class="text-muted">

                        Apartments, Villas and Open Plots.

                    </p>

                </div>

            </div>

            <div class="col-lg-3">

                <div class="card border-0 shadow-sm text-center p-4 h-100">

                    <div class="display-5">⚡</div>

                    <h5 class="mt-3">Easy Search</h5>

                    <p class="text-muted">

                        Find your property in minutes.

                    </p>

                </div>

            </div>

        </div>

    </div>

</section>

<!-- ================= SELL PROPERTY ================= -->

<section class="py-5">

    <div class="container">

        <div class="bg-success text-white rounded-4 p-5 text-center">

            <h2 class="fw-bold">

                Want to Sell Your Property?

            </h2>

            <p class="lead">

                List your property on BhoomiLink and reach genuine buyers.

            </p>

            <a asp-controller="SellProperty"
               asp-action="Index"
               class="btn btn-success btn-lg rounded-pill px-4">

                <i class="bi bi-house-fill me-2"></i>

                Sell Property

            </a>

        </div>

    </div>

</section>