<!-- ================= FEATURED PROPERTIES ================= -->

<section class="container py-5">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h2 class="fw-bold mb-1">

                Featured Properties

            </h2>

            <p class="text-muted mb-0">

                Discover verified properties across Andhra Pradesh.

            </p>

        </div>

        <a asp-controller="Property"
           asp-action="BuyProperties"
           class="btn btn-outline-success rounded-pill">

            View All

            <i class="bi bi-arrow-right ms-1"></i>

        </a>

    </div>

    <div class="row g-4">

        <!-- Card 1 -->

        <div class="col-lg-4">

            <div class="card property-card border-0">

                <div class="property-image">

                    <img src="https://images.unsplash.com/photo-1505693416388-ac5ce068fe85?w=800"
                         class="card-img-top"
                         alt="Property">

                    <span class="badge bg-success property-type">

                        Apartment

                    </span>

                    <span class="badge bg-light text-success property-verified">

                        <i class="bi bi-patch-check-fill"></i>

                        Verified

                    </span>

                </div>

                <div class="card-body">

                    <h4 class="text-success fw-bold mb-2">

                        ₹68 Lakhs

                    </h4>

                    <h5 class="fw-bold">

                        2BHK Apartment

                    </h5>

                    <p class="text-muted mb-3">

                        <i class="bi bi-geo-alt-fill text-danger"></i>

                        Visakhapatnam

                    </p>

                    <div class="property-features">

                        <span>

                            <i class="bi bi-door-open"></i>

                            2 Bed

                        </span>

                        <span>

                            <i class="bi bi-droplet"></i>

                            2 Bath

                        </span>

                        <span>

                            <i class="bi bi-rulers"></i>

                            1350 SFT

                        </span>

                    </div>

                    <hr>

                    <a asp-controller="Property"
                       asp-action="Details"
                       asp-route-id="1"
                       class="btn btn-success w-100 rounded-pill">

                        View Details

                        <i class="bi bi-arrow-right ms-1"></i>

                    </a>

                </div>

            </div>

        </div>

        <!-- Card 2 -->

        <div class="col-lg-4">

            <div class="card property-card border-0">

                <div class="property-image">

                    <img src="https://images.unsplash.com/photo-1505693416388-ac5ce068fe85?w=800"
                         class="card-img-top"
                         alt="Property">

                    <span class="badge bg-success property-type">

                        Villas

                    </span>

                    <span class="badge bg-light text-success property-verified">

                        <i class="bi bi-patch-check-fill"></i>

                        Verified

                    </span>

                </div>

                <div class="card-body">

                    <h4 class="text-success fw-bold mb-2">

                        ₹90 Lakhs

                    </h4>

                    <h5 class="fw-bold">

                        2BHK Apartment

                    </h5>

                    <p class="text-muted mb-3">

                        <i class="bi bi-geo-alt-fill text-danger"></i>

                        Visakhapatnam

                    </p>

                    <div class="property-features">

                        <span>

                            <i class="bi bi-door-open"></i>

                            2 Bed

                        </span>

                        <span>

                            <i class="bi bi-droplet"></i>

                            2 Bath

                        </span>

                        <span>

                            <i class="bi bi-rulers"></i>

                            1350 SFT

                        </span>

                    </div>

                    <hr>

                    <a asp-controller="Property"
                       asp-action="Details"
                       asp-route-id="1"
                       class="btn btn-success w-100 rounded-pill">

                        View Details

                        <i class="bi bi-arrow-right ms-1"></i>

                    </a>

                </div>

            </div>

        </div>

        <!-- Card 3 -->

        <div class="col-lg-4">

            <div class="card property-card border-0">

                <div class="property-image">

                    <img src="https://images.unsplash.com/photo-1505693416388-ac5ce068fe85?w=800"
                         class="card-img-top"
                         alt="Property">

                    <span class="badge bg-success property-type">

                        Open Plot

                    </span>

                    <span class="badge bg-light text-success property-verified">

                        <i class="bi bi-patch-check-fill"></i>

                        Verified

                    </span>

                </div>

                <div class="card-body">

                    <h4 class="text-success fw-bold mb-2">

                        ₹60 Lakhs

                    </h4>

                    <h5 class="fw-bold">

                        Open Plot

                    </h5>

                    <p class="text-muted mb-3">

                        <i class="bi bi-geo-alt-fill text-danger"></i>

                        Visakhapatnam

                    </p>

                    <div class="property-features">

                        <span>

                            <i class="bi bi-door-open"></i>

                            0 Bed

                        </span>

                        <span>

                            <i class="bi bi-droplet"></i>

                            0 Bath

                        </span>

                        <span>

                            <i class="bi bi-rulers"></i>

                            1350 Sq yards

                        </span>

                    </div>

                    <hr>



                    <a asp-controller="Property"
                       asp-action="Details"
                       asp-route-id="1"
                       class="btn btn-success w-100 rounded-pill">

                        View Details

                        <i class="bi bi-arrow-right ms-1"></i>

                    </a>

                </div>

            </div>

        </div>

    </div>

</section>

<!-- ================= WHY BHOOMILINK ================= -->

<section class="py-5 bg-light">

    <div class="container">

        <div class="text-center mb-5">

            <h2 class="fw-bold">

