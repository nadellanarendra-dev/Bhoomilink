@{
    ViewData["Title"] = "Terms & Conditions";
}

<link href="~/css/privacy-policy.css" rel="stylesheet" />

<!-- Hero -->

<section class="privacy-hero">

    <div class="container text-center">

        <span class="hero-badge">

            <i class="bi bi-file-earmark-text-fill"></i>

            Terms & Conditions

        </span>

        <h1>
            Terms & Conditions
        </h1>

        <p>
            By accessing or using BhoomiLink, you agree to comply with these
            Terms & Conditions. Please read them carefully before using our
            website and services.
        </p>

        <small class="text-muted">

            Last Updated: August 2026

        </small>

    </div>

</section>

<!-- Content -->

<section class="privacy-content">

    <div class="container">

        <div class="policy-card">

            <h3>
                <i class="bi bi-person-check-fill"></i>
                Acceptance of Terms
            </h3>

            <p>
                By using BhoomiLink, you acknowledge that you have read,
                understood, and agreed to these Terms & Conditions.
            </p>

        </div>

        <div class="policy-card">

            <h3>
                <i class="bi bi-house-fill"></i>
                Property Listings
            </h3>

            <ul>

                <li>Users must provide accurate and complete property information.</li>

                <li>Only authorised owners, agents, or developers should submit listings.</li>

                <li>BhoomiLink reserves the right to review, edit, approve, or reject any listing.</li>

                <li>False, misleading, duplicate, or illegal listings may be removed without notice.</li>

            </ul>

        </div>

        <div class="policy-card">

            <h3>
                <i class="bi bi-shield-check"></i>
                User Responsibilities
            </h3>

            <ul>

                <li>Provide truthful information.</li>

                <li>Comply with all applicable laws and regulations.</li>

                <li>Do not misuse or attempt to disrupt the website.</li>

                <li>Respect the rights of other users.</li>

            </ul>

        </div>

        <div class="policy-card">

            <h3>
                <i class="bi bi-exclamation-circle-fill"></i>
                Limitation of Liability
            </h3>

            <p>
                BhoomiLink acts only as a property listing platform.
                We do not guarantee the accuracy, legality, ownership,
                pricing, or completeness of any property listing.
                Users should independently verify all information before
                making any property-related decisions.
            </p>

        </div>

        <div class="policy-card">

            <h3>
                <i class="bi bi-ban"></i>
                Prohibited Activities
            </h3>

            <ul>

                <li>Posting false or fraudulent property listings.</li>

                <li>Uploading unlawful, offensive, or misleading content.</li>

                <li>Attempting to access restricted areas of the website.</li>

                <li>Using BhoomiLink for illegal purposes.</li>

            </ul>

        </div>

        <div class="policy-card">

            <h3>
                <i class="bi bi-arrow-repeat"></i>
                Changes to These Terms
            </h3>

            <p>
                BhoomiLink may update these Terms & Conditions at any time.
                Changes become effective once published on this page.
            </p>

        </div>

        <div class="policy-card">

            <h3>
                <i class="bi bi-envelope-fill"></i>
                Contact Us
            </h3>

            <p>

                If you have any questions regarding these Terms & Conditions,
                please contact us.

            </p>

            <p>

                <strong>Email:</strong> bhoomilinks@gmail.com<br />

                <strong>Phone:</strong> +91 95817 51622

            </p>

        </div>

    </div>

</section>