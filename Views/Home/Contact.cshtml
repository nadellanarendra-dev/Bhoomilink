@{
    ViewData["Title"] = "Contact Us";
}

<link href="~/css/contact.css" rel="stylesheet" />

<!-- Hero Section -->
<section class="contact-hero">
    <div class="container">

        <div class="row justify-content-center text-center">

            <div class="col-lg-8">

                <span class="hero-badge">
                    <i class="bi bi-headset"></i>
                    We're Here to Help
                </span>

                <h1 class="display-5 fw-bold mt-3">
                    Contact BhoomiLink
                </h1>

                <p class="lead text-muted mt-3">
                    Have questions about buying, selling, or listing a property?
                    Our team is happy to assist you.
                </p>

                <div class="mt-4">

                    <a href="tel:+919581751622"
                       class="btn btn-success btn-lg me-3 px-4">

                        <i class="bi bi-telephone-fill me-2"></i>
                        Call Now

                    </a>

                    <a href="https://wa.me/919581751622"
                       target="_blank"
                       class="btn btn-outline-success btn-lg px-4">

                        <i class="bi bi-whatsapp me-2"></i>
                        WhatsApp

                    </a>

                </div>

            </div>

        </div>

    </div>
</section>

<!-- Contact Information -->
<section class="py-5">

    <div class="container">

        <div class="row g-4">

            <!-- Call -->

            <div class="col-lg-3 col-md-6">

                <div class="contact-card">

                    <div class="contact-icon bg-success">
                        <i class="bi bi-telephone-fill"></i>
                    </div>

                    <h5>Call Us</h5>

                    <p>
                        +91 95817 51622
                    </p>

                    <a href="tel:+919581751622"
                       class="btn btn-success btn-sm rounded-pill">

                        Call Now

                    </a>

                </div>

            </div>

            <!-- Email -->

            <div class="col-lg-3 col-md-6">

                <div class="contact-card">

                    <div class="contact-icon bg-primary">
                        <i class="bi bi-envelope-fill"></i>
                    </div>

                    <h5>Email</h5>

                    <p>
                        bhoomilinks@gmail.com
                    </p>

                    <a href="mailto:contact@bhoomilink.com"
                       class="btn btn-primary btn-sm rounded-pill">

                        Send Email

                    </a>

                </div>

            </div>

            <!-- WhatsApp -->

            <div class="col-lg-3 col-md-6">

                <div class="contact-card">

                    <div class="contact-icon whatsapp-bg">
                        <i class="bi bi-whatsapp"></i>
                    </div>

                    <h5>WhatsApp</h5>

                    <p>
                        Chat with us instantly
                    </p>

                    <a href="https://wa.me/919581751622"
                       target="_blank"
                       class="btn btn-success btn-sm rounded-pill">

                        Chat Now

                    </a>

                </div>

            </div>

            <!-- Address -->

            <div class="col-lg-3 col-md-6">

                <div class="contact-card">

                    <div class="contact-icon bg-warning text-dark">
                        <i class="bi bi-geo-alt-fill"></i>
                    </div>

                    <h5>Location</h5>

                    <p>
                        Andhra Pradesh<br />
                        India
                    </p>

                </div>

            </div>

        </div>

    </div>

</section>

<!-- Business Hours -->

<section class="pb-5">

    <div class="container">

        <div class="business-card">

            <div class="row align-items-center">

                <div class="col-lg-2 text-center">

                    <i class="bi bi-headset business-icon"></i>

                </div>

                <div class="col-lg-10">

                    <h3 class="fw-bold text-success">

                        Customer Support Availability

                    </h3>

                    <div class="row mt-4">

                        <div class="col-md-6">

                            <strong>Monday - Sunday</strong>

                            <p class="text-muted mb-0">

                                9:00 AM - 7:00 PM

                            </p>

                        </div>

                        <div class="col-md-6">

                            <strong>Support Channels</strong>

                            <p class="text-muted mb-0">

                                Phone • WhatsApp • Email

                            </p>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>

<!-- Help Section -->

<section class="pb-5">

    <div class="container">

        <div class="help-box text-center">

            <h2 class="fw-bold mb-3">

                Need Assistance?

            </h2>

            <p class="text-muted">

                Whether you're buying your first home, selling land,
                or listing a commercial property,
                our team is ready to help.

            </p>

            <div class="mt-4">

                <a href="tel:+919581751622"
                   class="btn btn-success btn-lg me-3">

                    <i class="bi bi-telephone-fill me-2"></i>

                    Call Us

                </a>

                <a href="https://wa.me/919581751622"
                   target="_blank"
                   class="btn btn-outline-success btn-lg">

                    <i class="bi bi-whatsapp me-2"></i>

                    Chat on WhatsApp

                </a>

            </div>

        </div>

    </div>

</section>