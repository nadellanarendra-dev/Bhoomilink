@{
    ViewData["Title"] = "Privacy Policy";
}

<link href="~/css/privacy-policy.css" rel="stylesheet" />

<!-- Hero -->

<section class="privacy-hero">

    <div class="container text-center">

        <span class="hero-badge">

            <i class="bi bi-shield-lock-fill"></i>

            Privacy Policy

        </span>

        <h1>
            Your Privacy Matters
        </h1>

        <p>
            BhoomiLink respects your privacy and is committed to protecting
            your personal information. This Privacy Policy explains how we
            collect, use, and protect your information when you use our website.
        </p>

        <small class="text-muted">

            Last Updated: August 2026

        </small>

    </div>

</section>

<!-- Policy -->

<section class="privacy-content">

    <div class="container">

        <!-- Section -->

        <div class="policy-card">

            <h3>

                <i class="bi bi-person-fill"></i>

                Information We Collect

            </h3>

            <p>
                When you interact with BhoomiLink, we may collect information such as:
            </p>

            <ul>

                <li>Name</li>

                <li>Mobile Number</li>

                <li>Email Address</li>

                <li>Property Details submitted for listing</li>

                <li>Messages or enquiries you send us</li>

            </ul>

        </div>

        <!-- Section -->

        <div class="policy-card">

            <h3>

                <i class="bi bi-gear-fill"></i>

                How We Use Your Information

            </h3>

            <ul>

                <li>To review and publish your property listings.</li>

                <li>To contact you regarding your listing or enquiry.</li>

                <li>To improve our website and services.</li>

                <li>To provide customer support.</li>

            </ul>

        </div>

        <!-- Section -->

        <div class="policy-card">

            <h3>

                <i class="bi bi-share-fill"></i>

                Information Sharing

            </h3>

            <p>

                BhoomiLink does not sell your personal information to third parties.

                Property details that you voluntarily submit for listing may be
                displayed publicly as part of your property advertisement.

            </p>

        </div>

        <!-- Section -->

        <div class="policy-card">

            <h3>

                <i class="bi bi-cookie"></i>

                Cookies

            </h3>

            <p>

                BhoomiLink may use cookies or similar technologies to improve
                website functionality and enhance your browsing experience.

            </p>

        </div>

        <!-- Section -->

        <div class="policy-card">

            <h3>

                <i class="bi bi-box-arrow-up-right"></i>

                Third-Party Services

            </h3>

            <p>

                BhoomiLink may use trusted third-party services including
                Google Forms, Google Maps, WhatsApp, and analytics services
                to improve the user experience.

            </p>

        </div>

        <!-- Section -->

        <div class="policy-card">

            <h3>

                <i class="bi bi-shield-check"></i>

                Data Security

            </h3>

            <p>

                We take reasonable measures to protect the information you
                provide. However, no method of internet transmission or
                electronic storage is completely secure.

            </p>

        </div>

        <!-- Section -->

        <div class="policy-card">

            <h3>

                <i class="bi bi-envelope-fill"></i>

                Contact Us

            </h3>

            <p>

                If you have any questions regarding this Privacy Policy,
                please contact us.

            </p>

            <p>

                <strong>Email:</strong> bhoomilinks@gmail.com<br />

                <strong>Phone:</strong> +91 95817 51622

            </p>

        </div>

    </div>

</section>