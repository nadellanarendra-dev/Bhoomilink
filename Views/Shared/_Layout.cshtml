<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BhoomiLink</title>

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css" rel="stylesheet" />

    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <!-- Site CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Bhoomilink.styles.css" asp-append-version="true" />
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
</head>

<body>

    <!-- Header -->
    <!-- ================= HEADER ================= -->

    <header>

        <nav class="navbar navbar-expand-lg bg-white shadow-sm sticky-top">

            <div class="container">

                <!-- Logo -->

                <a class="navbar-brand d-flex align-items-center"
                   asp-controller="Home"
                   asp-action="Index">

                    <img src="~/images/logo.png"
                         class="logo"
                         alt="BhoomiLink" />

                </a>

                <!-- Mobile Toggle -->

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#navbarNav">

                    <span class="navbar-toggler-icon"></span>

                </button>

                <!-- Menu -->

                <div class="collapse navbar-collapse"
                     id="navbarNav">

                    <ul class="navbar-nav ms-auto align-items-lg-center">

                        <li class="nav-item">

                            <a class="nav-link"
                               asp-controller="Home"
                               asp-action="Index">

                                Home

                            </a>

                        </li>

                        <li class="nav-item">

                            <a class="nav-link"
                               asp-controller="Property"
                               asp-action="BuyProperties">

                                Buy Properties

                            </a>

                        </li>

                     @*    <li class="nav-item">

                            <a class="nav-link"
                               asp-controller="Home"
                               asp-action="About">

                                About

                            </a>

                        </li> *@

                        <li class="nav-item">

                            <a class="nav-link"
                               asp-controller="Home"
                               asp-action="Contact">

                                Contact

                            </a>

                        </li>

                        <li class="nav-item">

                            <a class="nav-link"
                               asp-controller="Home"
                               asp-action="Contact">

                                Privacy Policy

                            </a>

                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="SellProperty"
                               asp-action="Index">
                                Sell Property
                            </a>
                        </li>

                    </ul>

                </div>

            </div>

        </nav>

    </header>

    <!-- Body -->

    <main class="main-content">

        @RenderBody()

    </main>

    <!-- Footer -->
    <footer class="site-footer mt-5">
        <div class="container">
            <div class="row g-4 align-items-start">
                <!-- Logo Section -->
                <div class="col-lg-4 col-md-6">
                    <a asp-controller="Home" asp-action="Index" class="d-inline-block mb-3">
                        <img src="~/images/f96ca674-2568-412c-bd0c-d75e6436a94c.png"
                             class="footer-logo"
                             alt="BhoomiLink" />
                    </a>
                    <p class="footer-about">Your trusted platform for buying, selling, and discovering properties across Andhra Pradesh.</p>
                    <div class="footer-social">
                        <a href="#" aria-label="Facebook"><i class="bi bi-facebook"></i></a>
                        <a href="#" aria-label="Twitter"><i class="bi bi-twitter-x"></i></a>
                        <a href="#" aria-label="LinkedIn"><i class="bi bi-linkedin"></i></a>
                        <a href="#" aria-label="Instagram"><i class="bi bi-instagram"></i></a>
                    </div>
                </div>

                <!-- Quick Links -->
                <div class="col-lg-2 col-md-6">
                    <h6>Quick Links</h6>
                    <ul class="list-unstyled footer-list">
                        <li><a href="#" class="footer-link">Home</a></li>
                        <li><a href="#" class="footer-link">Buy Properties</a></li>
                        <li><a href="#" class="footer-link">About Us</a></li>
                        <li><a href="#" class="footer-link">Privacy Policy</a></li>
                    </ul>
                </div>

                <!-- Contact -->
                <div class="col-lg-3 col-md-6">
                    <h6>Contact Us</h6>
                    <ul class="list-unstyled footer-contact">
                        <li>
                            <span><i class="bi bi-telephone"></i></span>
                            <a href="tel:+91-XXXXXXXXXX">+91-9581751622</a>
                        </li>
                        <li>
                            <span><i class="bi bi-envelope"></i></span>
                            <a href="mailto:contact@bhoomilink.com">contact@bhoomilink.com</a>
                        </li>
                        <li>
                            <span><i class="bi bi-geo-alt"></i></span>
                            Andhra Pradesh, India
                        </li>
                    </ul>
                </div>

                <div class="col-lg-3 col-md-6">
                    <div class="footer-cta">
                        <h6>Ready to list?</h6>
                        <p>Reach property buyers faster with BhoomiLink.</p>
                        <a href="#" class="btn btn-success">Post Property</a>
                    </div>
                </div>
            </div>

            <hr />
            <div class="footer-disclaimer">

                <div class="d-flex align-items-start">

                    <i class="bi bi-info-circle-fill disclaimer-icon"></i>

                    <div>

                        <h6>Property Disclaimer</h6>

                        <p>
                            BhoomiLink manually reviews property submissions before publishing.
                            While we strive to provide genuine property listings, buyers and tenants
                            are advised to independently verify ownership, legal documents,
                            government approvals, property dimensions, pricing, and other details
                            before making any payment or transaction.
                            BhoomiLink acts only as a property listing platform and is not a party
                            to any sale, purchase, rental, or lease agreement.
                        </p>

                    </div>

                </div>

            </div>
            <hr />
            <div class="footer-bottom">
                <div>
                    <p>&copy; 2026 BhoomiLink. All rights reserved.</p>
                </div>
                <div class="footer-bottom-links">
                    <a href="#">Terms</a>
                    <a href="#">Privacy</a>
                    <a href="#">Support</a>
                </div>
            </div>
        </div>
    </footer>

    <!-- Scripts -->

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>
