<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BhoomiLink</title>

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css" rel="stylesheet" />

    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <!-- Site CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Bhoomilink.styles.css" asp-append-version="true" />
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
</head>

<body>

    <!-- Header -->
    <!-- ================= HEADER ================= -->

    <header>

        <nav class="navbar navbar-expand-lg bg-white shadow-sm sticky-top">

            <div class="container">

                <!-- Logo -->

                <a class="navbar-brand d-flex align-items-center"
                   asp-controller="Home"
                   asp-action="Index">

                    <img src="~/images/logo.png"
                         class="logo"
                         alt="BhoomiLink" />

                </a>

                <!-- Mobile Toggle -->

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#navbarNav">

                    <span class="navbar-toggler-icon"></span>

                </button>

                <!-- Menu -->

                <div class="collapse navbar-collapse"
                     id="navbarNav">

                    <ul class="navbar-nav ms-auto align-items-lg-center">

                        <li class="nav-item">

                            <a class="nav-link"
                               asp-controller="Home"
                               asp-action="Index">

                                Home

                            </a>

                        </li>

                        <li class="nav-item">

                            <a class="nav-link"
                               asp-controller="Property"
                               asp-action="BuyProperties">

                                Buy Properties

                            </a>

                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="SellProperty"
                               asp-action="Index">
                                Sell Property
                            </a>
                        </li>

                        <li class="nav-item">

                            <a class="nav-link"
                               asp-controller="Home"
                               asp-action="About">

                                About

                            </a>

                        </li>

                        <li class="nav-item">

                            <a class="nav-link"
                               asp-controller="Home"
                               asp-action="Contact">

                                Contact

                            </a>

                        </li>

                    </ul>

                </div>

            </div>

        </nav>

    </header>

    <!-- Body -->

    <main class="main-content">

        @RenderBody()

    </main>

    <!-- Footer -->
    <footer class="site-footer mt-5">

        <div class="container">

            <div class="row g-4">

                <!-- Logo -->

                <div class="col-lg-4">

                    <a asp-controller="Home"
                       asp-action="Index">

                        <img src="~/images/logo.png"
                             class="footer-logo"
                             alt="BhoomiLink" />

                    </a>

                    <p class="footer-about mt-3">

                        Your trusted platform for buying, selling, and discovering
                        properties across Andhra Pradesh.

                    </p>

                </div>

                <!-- Quick Links -->

                <div class="col-lg-2 col-md-6">

                    <h6>Quick Links</h6>

                    <ul class="list-unstyled footer-list">

                        <li>
                            <a asp-controller="Home"
                               asp-action="Index"
                               class="footer-link">

                                Home

                            </a>
                        </li>

                        <li>
                            <a asp-controller="Property"
                               asp-action="BuyProperties"
                               class="footer-link">

                                Buy Properties

                            </a>
                        </li>

                        <li>
                            <a asp-controller="SellProperty"
                               asp-action="Index"
                               class="footer-link">

                                Sell Property

                            </a>
                        </li>

                        <li>
                            <a asp-controller="Home"
                               asp-action="About"
                               class="footer-link">

                                About Us

                            </a>
                        </li>

                        <li>
                            <a asp-controller="Home"
                               asp-action="Contact"
                               class="footer-link">

                                Contact Us

                            </a>
                        </li>

                    </ul>

                </div>

                <!-- Legal -->

                <div class="col-lg-3 col-md-6">

                    <h6>Legal</h6>

                    <ul class="list-unstyled footer-list">

                        <li>

                            <a asp-controller="Home"
                               asp-action="PrivacyPolicy"
                               class="footer-link">

                                Privacy Policy

                            </a>

                        </li>

                        <li>

                            <a asp-controller="Home"
                               asp-action="Terms"
                               class="footer-link">

                                Terms & Conditions

                            </a>

                        </li>

                        <li>

                            <a asp-controller="Home"
                               asp-action="Disclaimer"
                               class="footer-link">

                                Disclaimer

                            </a>

                        </li>

                    </ul>

                </div>

                <!-- Contact -->

                <div class="col-lg-3 col-md-12">

                    <h6>Contact Us</h6>

                    <ul class="list-unstyled footer-contact">

                        <li>

                            <i class="bi bi-telephone"></i>

                            <a href="tel:+919581751622">

                                +91 95817 51622

                            </a>

                        </li>

                        <li>

                            <i class="bi bi-envelope"></i>

                            <a href="mailto:contact@bhoomilink.com">

                               bhoomilinks@gmail.com

                            </a>

                        </li>

                        <li>

                            <i class="bi bi-geo-alt"></i>

                            Andhra Pradesh, India

                        </li>

                    </ul>

                    <a asp-controller="SellProperty"
                       asp-action="Index"
                       class="btn btn-success mt-3">

                        <i class="bi bi-plus-circle me-2"></i>

                        Post Property

                    </a>

                </div>

            </div>

            <hr />

            <!-- Property Disclaimer -->

            <div class="footer-disclaimer">

                <div class="d-flex align-items-start">

                    <i class="bi bi-info-circle-fill disclaimer-icon"></i>

                    <div>

                        <h6>Property Disclaimer</h6>

                        <p>

                            BhoomiLink manually reviews property submissions before publishing.
                            Buyers and tenants are advised to independently verify ownership,
                            legal documents, government approvals, pricing, and all other
                            property details before making any payment or transaction.
                            BhoomiLink acts solely as a property listing platform and is not
                            a party to any property transaction.

                        </p>

                    </div>

                </div>

            </div>

            <hr />

            <!-- Bottom -->

            <div class="footer-bottom">

                <p class="mb-0">

                    © 2026 BhoomiLink. All Rights Reserved.

                </p>

                <div class="footer-bottom-links">

                    <a asp-controller="Home"
                       asp-action="PrivacyPolicy">

                        Privacy

                    </a>

                    <a asp-controller="Home"
                       asp-action="Terms">

                        Terms

                    </a>

                    <a asp-controller="Home"
                       asp-action="Disclaimer">

                        Disclaimer

                    </a>

                </div>

            </div>

        </div>

    </footer>

    <!-- Scripts -->

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>
